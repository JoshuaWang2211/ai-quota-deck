{
  "manifest_version": 3,
  "name": "AI Quota Deck Browser Bridge",
  "version": "0.3.0",
  "description": "Sends local Gemini and Grok quota snapshots to AI Quota Deck.",
  "key": "",
  "permissions": [
    "alarms",
    "idle",
    "storage"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://grok.com/*"
  ],
  "action": {
    "default_title": "Connect AI Quota Deck"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["src/gemini-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["src/gemini-parser.js", "src/gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://grok.com/*"],
      "js": ["src/grok-parser.js", "src/grok.js"],
      "run_at": "document_idle"
    }
  ]
}
